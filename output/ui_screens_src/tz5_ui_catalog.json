    {
      "screen_id": "SCREEN_01_REC_LIVE_VIEW_OSD",
      "title_en": "Recording Live View OSD & Telemetry Overlay",
      "title_pt": "Tela Live View de Disparo (OSD + Telemetria \u00c3\u0093ptica 10x)",
      "mode_badge": "REC / iA",
      "primary_handler_va": "0x55D6BCE8",
      "descriptor_table_va": "0x55E67BAC",
      "summary": "Renders real-time shooting HUD over the 3.0-inch 460k-dot LCD: Recording Mode badge (iA/P/SCN/Motion), Mega O.I.S. status, 9M EZ picture size, AF/AE lock, 1x-10x Leica DC Vario-Elmar zoom bar, live histogram (SID 0x0297), and battery gauge."
    },
    {
      "screen_id": "SCREEN_02_Q_MENU_BAR",
      "title_en": "Quick Menu (Q.MENU) Top Dropdown Bar",
      "title_pt": "Barra R\u00c3\u00a1pida Q.MENU (Ajustes Instant\u00c3\u00a2neos em Live View)",
      "mode_badge": "Q.MENU",
      "primary_handler_va": "0x55D6AB3E",
      "descriptor_table_va": "0x55E67CCC",
      "summary": "Triggered by the dedicated Q.MENU / Delete button during shooting. Draws a horizontal quick-access bar at the top of the LCD with drop-down rollers for Stabilizer, Burst, AF Mode, White Balance, ISO, Intelligent Exposure, Picture Size, and LCD Mode."
    },
    {
      "screen_id": "SCREEN_03_REC_MAIN_MENU",
      "title_en": "[REC] Main Shooting Menu (Pages 1-4)",
      "title_pt": "Menu Principal de Fotografia [REC] (P\u00c3\u00a1ginas 1 a 4)",
      "mode_badge": "[REC]",
      "primary_handler_va": "0x55D6BCE8",
      "descriptor_table_va": "0x55E67BAC",
      "summary": "Full-screen tabbed menu driven by the 24-byte VenusMenuItemDescriptor tables at 0x55E67BAC..0x55E67E64 (22 items: Picture Size, Quality, Aspect Ratio, Intelligent ISO, Sensitivity, White Balance, WB Adjust, Metering Mode, AF Mode, Quick AF, Continuous AF, I.Exposure, Color Mode, Stabilizer, Min. Shtr Speed, Burst, Digital Zoom, Audio Rec., AF Assist Lamp, Clock Set)."
    },
    {
      "screen_id": "SCREEN_04_MOTION_PICTURE_MENU",
      "title_en": "[MOTION PICTURE] HD 720p Video Recording Menu",
      "title_pt": "Menu de Grava\u00c3\u00a7\u00c3\u00a3o de V\u00c3\u00addeo HD [IMAGEM EM MOVIMENTO]",
      "mode_badge": "[MOTION]",
      "primary_handler_va": "0x55D6BCE8",
      "descriptor_table_va": "0x55E67E7C",
      "summary": "Configures HD 1280x720 (30fps/15fps) 16:9 and WVGA/VGA Motion JPEG recording modes (SID 0x004B), Picture Quality/Frame Rate (30fps/15fps/10fps), Continuous AF, White Balance, Metering Mode, I.Exposure, Color Mode, and Optical Stabilizer."
    },
    {
      "screen_id": "SCREEN_05_SCENE_MODE_GRID",
      "title_en": "[SCN] 22-Scene Mode Selection Grid & Help Card",
      "title_pt": "Grade de Sele\u00c3\u00a7\u00c3\u00a3o de 22 Modos de Cena [SCN] (Retrato, Paisagem, Noite, Beb\u00c3\u00aa, Subaqu\u00c3\u00a1tico...)",
