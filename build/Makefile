src/main.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tz5-fw-tool.dir/build.make CMakeFiles/tz5-fw-tool.dir/src/main.cpp.s
.PHONY : src/main.cpp.s

